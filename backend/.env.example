# Copy this file to backend/.env and set a password of at least 8 characters.
# The server creates the desk login once, the first time it starts.
# Changing these later does not reset an existing desk login.
ADMIN_USERNAME=desk
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Desk
ADMIN_LAST_NAME=Centrecourt
ADMIN_PHONE=09000000000
ADMIN_EMAIL=desk@centrecourt.local
