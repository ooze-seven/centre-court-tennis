# Copy this file to backend/.env and set a password of at least 8 characters.
# The server creates the desk login once, the first time it starts.
# Changing these later does not reset an existing desk login.
ADMIN_USERNAME=desk
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Desk
ADMIN_LAST_NAME=Centrecourt
ADMIN_PHONE=09000000000
ADMIN_EMAIL=desk@centrecourt.local
# Comma-separated sites allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true on Render so the sign-in cookie is accepted from the live court.
COOKIE_SECURE=false
# Supabase project URL and the service secret. Never put the secret in the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
